@startuml component-interaction
title Component interaction from UI events to persistent storage

top to bottom direction
skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowThickness 1.2
skinparam ranksep 65
skinparam nodesep 50
skinparam rectangle {
  BorderColor #4A5568
  FontColor #1F2937
  RoundCorner 12
}
skinparam database {
  BorderColor #9A3412
  FontColor #1F2937
}

rectangle "Browser UI\nindex.php, project.php, ..." as UI #E8F2FF
rectangle "Client Logic\njs/dashboard.js\njs/kanban.js\njs/search-filter.js" as JS #EDF7FF
rectangle "REST Endpoints\napi/*.php" as API #EAF9EA
rectangle "Domain Logic\nincludes/*-functions.php" as SVC #F6F6F6
database "MySQL Storage\nusers, projects,\nproject_members,\nproject_join_requests,\ntasks" as DB #FFE7D6
rectangle "Shared Utilities\nincludes/*.php" as INC #FFF4E8

UI -[hidden]down- JS
JS -[hidden]down- API
API -[hidden]down- SVC
SVC -[hidden]down- DB
INC -[hidden]right- SVC

UI --> JS : UI events
JS --> API : fetch JSON
API --> SVC : route + auth
SVC --> DB : SQL query
DB --> SVC : rows
SVC --> API : service data
API --> JS : JSON response
JS --> UI : DOM update
INC --> SVC : session helpers

@enduml
