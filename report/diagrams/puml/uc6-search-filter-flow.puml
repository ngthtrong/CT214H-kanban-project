@startuml
title UC6 activity flow: multi-criteria search and pagination

skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam activity {
  BorderColor #4B5563
  BackgroundColor #F8FAFC
  DiamondBackgroundColor #FEF9C3
}

start
:Receive search text and filter parameters;
:Build SQL conditions with prepared statements;

if (Any criteria provided?) then (yes)
  :Run filtered query\nwith AND-composed conditions;
else (no)
  :Run default query for current project;
endif

:Count total rows;
:Compute pagination metadata\n(current_page, per_page, total_pages);
:Return tasks, grouped statuses,\nand pagination payload;
:Frontend refreshes board or list view;
stop

@enduml
