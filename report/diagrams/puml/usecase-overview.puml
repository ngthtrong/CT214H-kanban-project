@startuml usecase-overview
title Use-case overview (UC1 to UC6) - compact themed layout

top to bottom direction
skinparam backgroundColor #FFFCF4
skinparam shadowing false
skinparam packageStyle rectangle
skinparam roundcorner 12
skinparam usecase {
  BorderColor #6B4E16
  FontColor #1F2937
  BackgroundColor #FFF8E8
}
skinparam actor {
  BorderColor #0E7490
  FontColor #134E4A
}

actor "Project Owner" as Owner
actor "Project Member" as Member

rectangle "Team Kanban System" #FFF7E6 {
  usecase "UC1\nAuthentication\nand Profile" as UC1 #E7F7EA
  usecase "UC4\nTask CRUD and\nStatus Transitions" as UC4 #E3F2FF
  usecase "UC2\nProject Lifecycle\nManagement" as UC2 #DFF7F7
  usecase "UC6\nSearch, Filter\nand Pagination" as UC6 #FFE8C2
  usecase "UC3\nMember Invitation\nand Join Requests" as UC3 #FFE2E2
  usecase "UC5\nOwner Assignment\nand Member Claim" as UC5 #FFF1C9
}

UC1 -[hidden]down- UC4
UC4 -[hidden]down- UC2
UC6 -[hidden]down- UC3
UC2 -[hidden]down- UC5
UC5 -[hidden]down- UC6

Owner -[hidden]left- UC4
Member -[hidden]right- UC5

Owner --> UC1
Owner --> UC2
Owner --> UC3
Owner --> UC4
Owner --> UC5
Owner --> UC6

Member --> UC1
Member --> UC4
Member --> UC5
Member --> UC6

UC2 ..> UC1 : <<requires>>
UC3 ..> UC2 : <<requires>>
UC4 ..> UC2 : <<requires>>
UC5 ..> UC4 : <<extends>>
UC6 ..> UC4 : <<extends>>

@enduml
