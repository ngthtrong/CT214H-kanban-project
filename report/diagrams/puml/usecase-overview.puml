@startuml
title Use-case overview (UC1 to UC6)

left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #4B5563
}
skinparam actor {
  BorderColor #1D4ED8
  FontColor #1E3A8A
}

actor "Project Owner" as Owner
actor "Project Member" as Member

rectangle "Team Kanban System" {
  usecase "UC1\nAuthentication\nand Profile" as UC1
  usecase "UC2\nProject Lifecycle\nManagement" as UC2
  usecase "UC3\nMember Invitation\nand Join Requests" as UC3
  usecase "UC4\nTask CRUD and\nStatus Transitions" as UC4
  usecase "UC5\nOwner Assignment\nand Member Claim" as UC5
  usecase "UC6\nMulti-criteria Search\nand Pagination" as UC6
}

Owner --> UC1
Owner --> UC2
Owner --> UC3
Owner --> UC4
Owner --> UC5
Owner --> UC6

Member --> UC1
Member --> UC4
Member --> UC5
Member --> UC6

UC2 ..> UC1 : <<requires>>
UC3 ..> UC2 : <<requires>>
UC4 ..> UC2 : <<requires>>
UC5 ..> UC4 : <<extends>>
UC6 ..> UC4 : <<extends>>

@enduml
