@startuml
title UC3 activity flow: member invitation and join requests

skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam activity {
  BorderColor #4B5563
  BackgroundColor #F8FAFC
  DiamondBackgroundColor #FEF9C3
}

start
:Receive member-related request;

switch (Flow type)
case (Owner invites member)
  :Find user by username or email;
  if (User exists?) then (yes)
    if (Already member or pending?) then (yes)
      :Return duplication or conflict error;
      stop
    else (no)
      :Insert into project_members\nor auto-approve pending request;
    endif
  else (no)
    :Return user-not-found error;
    stop
  endif
case (User sends join request)
  :Validate project_code and membership state;
  if (Already member or pending?) then (yes)
    :Return duplication or conflict error;
    stop
  else (no)
    :Insert pending record\ninto project_join_requests;
  endif
case (Owner reviews request)
  :Load pending requests for project;
  if (Decision is approve?) then (yes)
    :Set request status approved;
    :Add requester into project_members;
  else (reject)
    :Set request status rejected;
  endif
endswitch

:Member workflow completed;
stop

@enduml
