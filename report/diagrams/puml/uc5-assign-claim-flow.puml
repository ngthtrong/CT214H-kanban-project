@startuml
title UC5 activity flow: owner assignment and member claim behavior

skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam activity {
  BorderColor #4B5563
  BackgroundColor #F8FAFC
  DiamondBackgroundColor #FEF9C3
}

start
:Receive assignment-related action;

if (Requester role is owner?) then (owner)
  :Owner selects assignee or unassign option;
  if (Selected assignee is member or NULL?) then (yes)
    :Persist assigned_to update;
    :Return success payload;
    stop
  else (no)
    :Return invalid-assignee error;
    stop
  endif
else (member)
  :Member requests to claim a task;
  if (Task currently unassigned?) then (yes)
    :Set assigned_to to requesting member;
    :Return success payload;
    stop
  else (no)
    :Return claim conflict error;
    stop
  endif
endif

@enduml
