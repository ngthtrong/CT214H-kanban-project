{
    "name": "kanban/app",
    "description": "Team Kanban Project Management Application",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Team CT214H",
            "email": "team@kanban.local"
        }
    ],
    "require": {
        "php": "^8.0"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.7",
        "phpmd/phpmd": "^2.13"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "lint": "@php vendor/bin/phpcs src",
        "lint:fix": "@php vendor/bin/phpcbf src",
        "mess": "@php vendor/bin/phpmd src text phpmd.xml",
        "quality": [
            "@lint",
            "@mess"
        ],
        "dev-server": "@php -S localhost:8000 -t ."
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
